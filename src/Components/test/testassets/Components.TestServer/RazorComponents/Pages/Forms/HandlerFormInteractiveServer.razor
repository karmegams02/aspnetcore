@page "/forms/handler-form-interactive-server"
@using Microsoft.AspNetCore.Components.Forms
@rendermode RenderMode.InteractiveServer

<h2>HandlerForm under InteractiveServer</h2>

<p>
    Verifies the JS branch a developer typically lands on: a circuit is
    established, <code>OnSubmit</code> fires in the browser without a page
    reload, and the URL is unchanged.
</p>

<p id="interactive">InteractiveServer</p>

<HandlerForm FormName="handler-form-interactive-server" PreventDefault="true" OnSubmit="HandleSubmit">
    <input id="send" type="submit" value="Send" />
</HandlerForm>

@if (_callbackFired)
{
    <p id="onsubmit-fired">OnSubmit callback fired</p>
}

<p id="url">@Navigation.Uri</p>

@code {
    bool _callbackFired;

    async Task HandleSubmit()
    {
        _callbackFired = true;
        await Task.Yield();
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;
}
