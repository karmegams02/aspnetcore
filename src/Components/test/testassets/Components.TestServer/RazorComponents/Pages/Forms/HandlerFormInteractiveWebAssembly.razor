@page "/forms/handler-form-interactive-webassembly"
@using Microsoft.AspNetCore.Components.Forms
@rendermode RenderMode.InteractiveWebAssembly

<h2>HandlerForm under InteractiveWebAssembly</h2>

<p>
    Same contract as the InteractiveServer page, but executed inside the
    WebAssembly runtime to make sure the form's DOM-only path works for
    both interactive render modes.
</p>

<p id="interactive">InteractiveWebAssembly</p>

<HandlerForm FormName="handler-form-interactive-wasm" PreventDefault="true" OnSubmit="HandleSubmit">
    <input id="send" type="submit" value="Send" />
</HandlerForm>

@if (_callbackFired)
{
    <p id="onsubmit-fired">OnSubmit callback fired</p>
}

<p id="url">@Navigation.Uri</p>

@code {
    bool _callbackFired;

    async Task HandleSubmit()
    {
        _callbackFired = true;
        await Task.Yield();
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;
}
