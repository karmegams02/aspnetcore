@page "/forms/handler-form-ssr-with-onsubmit"
@using Microsoft.AspNetCore.Components.Forms
@rendermode RenderMode.InteractiveServer

<h2>HandlerForm with OnSubmit callback (no PreventDefault)</h2>

<p>
    When <code>PreventDefault</code> is <em>not</em> set, the form has both a
    native HTML POST <em>and</em> an <code>OnSubmit</code> callback. Because
    <code>HandlerForm</code> does not install a <code>FormMappingContext</code>,
    the native POST would be rejected as 400 by the server-side endpoint.
    The interactive runtime short-circuits this: the JS handler intercepts
    the submit, runs <code>OnSubmit</code>, and the native POST never goes
    out. This test pins that contract.
</p>

<p id="interactive">InteractiveServer</p>

<HandlerForm FormName="handler-form-ssr-onsubmit" OnSubmit="HandleSubmit">
    <input id="send" type="submit" value="Send" />
</HandlerForm>

@if (_callbackFired)
{
    <p id="onsubmit-fired">OnSubmit callback fired</p>
}

<p id="url">@Navigation.Uri</p>

@code {
    bool _callbackFired;

    async Task HandleSubmit(EventArgs args)
    {
        _callbackFired = true;
        await Task.Yield();
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;
}
